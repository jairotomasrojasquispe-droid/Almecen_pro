{
  "name": "brahmco-taller-pro",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Almacen Taller Profesional - Brahmco - Vendible S/2500",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "setup:supabase": "node scripts/setupSupabase.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.44.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.394.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.brahmco.taller",
    "productName": "Brahmco Taller PRO",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
